{
  "name": "payment-resolution-desk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/main.ts\" \"vite --host 127.0.0.1\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/main.js",
    "start:configured": "node --env-file=.env dist/server/server/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval:validate": "node --import tsx scripts/validate-evaluation.ts",
    "eval:run": "node --import tsx scripts/evaluate.ts",
    "demo": "node scripts/start-demo.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
