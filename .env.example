# Copy to .env only in a fresh checkout; never commit your populated .env.
APP_MODE=paypal_sandbox
ANALYSIS_MODE=unavailable

# Internal local scope label, not a provider-issued merchant ID.
PAYPAL_MERCHANT_ID=paypal-sandbox-business
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_INVOICE_IDS=
PAYPAL_SETUP_APPROVED=false

# Gateway host only: the server appends /v1/chat/completions.
ASTRO_GATEWAY_URL=https://aig.astropods.ai
ASTRO_GATEWAY_API_KEY=
ASTROPODS_SPONSOR_CREDITS_VERIFIED=false
SYNTHETIC_DATA_APPROVED=false

# Enable ANALYSIS_MODE=astropods only after the corresponding checks are complete.
# Keep a no-card/credit-only account; no purchased credit or paid fallback.
# Default local port is 4317; default sandbox database is isolated under .local/.
